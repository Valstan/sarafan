# SETKA Project .gitignore

# Tool-local AI state (общие инструкции трекаются намеренно, ADR-0011)
# Правило: кэши/сессии/локальные настройки инструмента — мимо репо; общие
# инструкции и хуки, которые обязаны разъехаться на все машины, — в репо.
#
# - .claude/commands/  — исполняемые памятки процедур (start, reliz, close_session, …)
# - .claude/agents/    — кастомные субагенты (если появятся)
# - .claude/settings.json — командная политика permissions (ssh sarafan allowlist) + hooks (SessionStart git-sync)
# - .codex/hooks.json  — тот же SessionStart-хук git-sync для Codex (аналог settings.json)
# Остальное (worktrees, локальная сессия, settings.local.json конкретного компа) — локально.
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/settings.json
.codex/*
!.codex/hooks.json
.gemini/

# Secure configuration files
config/config_secure.py
config/config.secure.py
config/*.env
config/.env*
*.key
*.pem

# Secrets backup file
SECRETS_BACKUP.txt
SECRETS*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
env/

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Backup files
backup/*.sql
backup/*.sql.gz
backup/*.dump
backup/*.tar.gz

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Установочные пакеты расширений редакторов (VS Code / Cursor / …) —
# артефакт инструмента разработчика, а не код проекта. Правило заведено
# постфактум: 14 МБ `qwenlm.qwen-code-vscode-ide-companion-0.14.3-win32-x64.vsix`
# уехали в репо попутным `git add` вместе с несвязанной правкой (71127eb,
# 2026-04-14) и пролежали в дереве четыре месяца, занимая ~71% блоб-хранилища.
*.vsix

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
temp/

# рабочие файлы прогона облачной рутины классификатора (scripts/classifier_routine.py)
classifier_run/

# discovery scratch (см. /discover_communities) — keeper-скрипты без префикса `_`
# (scripts/discover_scan.py, scripts/seed_region_communities.py) коммитим; всё `_`-scratch — нет
scripts/_*.json
scripts/_*.sh
_scan_*.json

# Node modules (if any)
node_modules/

# Cache
.cache/
*.cache

# Old project analysis
old_project_analysis/postopus/

# AI Model weights (if stored locally)
models/*.bin
models/*.safetensors


# Фото рекламных клиентов (кабинет): данные, не код — на проде AD_UPLOAD_DIR
web/uploads/

# Автоснимки сессии (пишет хук Stop, scripts/session_autosave.py): локальная
# выжимка нитки. В git не едет — репозиторий публичный, а в репликах владельца
# может оказаться что угодно.
.claude/session-state/

# Переговорная hotline (пилот brain 03.10): присутствие сессии — эфемерно,
# в git не едет; ленты outbox (to-*.jsonl) — наоборот коммитятся своим flow.
hotline/presence.json
