##
# SETKA Nginx config template (editable)
#
# ⚠️ Это ШАБЛОН для нового бокса, а не файл техдомена SETKA.
#
# Твой бокс обслуживает техдомен конфигом `config/nginx_setka.conf` — он и
# копируется на бокс (`sudo cp config/nginx_setka.conf /etc/nginx/conf.d/setka.conf`).
# Этот файл — заготовка «подставить своё» для ДРУГОГО развёртывания: замени
# `YOUR_DOMAIN` на свой домен и пути, если они отличаются.
#
# Почему это важно (01.11, D-096): до правки `scripts/apply_nginx_config.sh`
# копировал на бокс именно ЭТОТ шаблон — с `listen 80`, плейсхолдером
# `YOUR_DOMAIN` и без TLS. То есть скрипт из документации сносил бы с
# техдомена HTTPS, а `location /` уводил бы в приложение всё подряд, включая
# сканеры (см. #251 и D-096). Скрипт теперь берёт настоящий конфиг.
#
# Upstream: FastAPI (uvicorn) on 127.0.0.1:8000
##

# HTTP -> HTTPS redirect + ACME challenge
server {
    listen 80;
    server_name YOUR_DOMAIN;

    # For Let's Encrypt verification
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Redirect all other requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;

    # TLS (Certbot-managed example)
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    # HSTS (enable once HTTPS works reliably)
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Static files
    location /static {
        alias /home/valstan/SETKA/web/static;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Загружаемые файлы — исключение из immutable (D-096 №3, 01.11).
    # Имя не несёт версию: загрузка пишет по исходному имени, поэтому тот же
    # URL отдаёт новое содержимое. `immutable` здесь обещал бы «навсегда те же
    # байты» — ложь, из-за которой браузер держал бы старую картинку до 30 дней.
    # `expires -1` = `Cache-Control: no-cache` — как отдаёт второй слой,
    # RevalidatingStaticFiles (web/static_files.py).
    location /static/broadcast/ {
        alias /home/valstan/SETKA/web/static/broadcast/;
        expires -1;
    }

    location /static/ad_offers/ {
        alias /home/valstan/SETKA/web/static/ad_offers/;
        expires -1;
    }

    # WebSocket support (if you add WS endpoints later)
    location /ws {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Discovery — sync endpoint держит запрос до завершения VK groups.search
    # (до 22 ключевиков × geo) + AI-категоризации (до 150 кандидатов через Groq).
    # На больших районах легко уходит за дефолтные 60s → nginx режет 504, фронт
    # получает HTML и падает на JSON.parse. Поднимаем до 180s именно для этого
    # location, не растягивая остальной API.
    location /api/discovery/trigger {
        proxy_pass http://127.0.0.1:8000/api/discovery/trigger;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 60s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    # Main application
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # Health check (no access log noise)
    location /api/health {
        proxy_pass http://127.0.0.1:8000/api/health;
        access_log off;
    }

    # Logs
    access_log /home/valstan/SETKA/logs/nginx_access.log setka_host;
    error_log /home/valstan/SETKA/logs/nginx_error.log;
}
