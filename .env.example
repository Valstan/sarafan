# SETKA Environment Configuration
# Скопируйте этот файл в .env и заполните реальными значениями
# НЕ коммитьте реальный .env в git!

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql+asyncpg://setka_user:YOUR_PASSWORD@localhost:5432/setka
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQLALCHEMY_ECHO=0

# ============================================================================
# Redis (Celery broker + caching)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# VK API
# ============================================================================
VK_API_VERSION=5.131

# VK токены (префикс VK_TOKEN_ автоматически собирает все токены)
VK_TOKEN_VALSTAN=your_token_here
VK_TOKEN_VITA=your_token_here

# ============================================================================
# DeepSeek API (нейро-движок экосистемы, D-024). Ключ — в комнате КАРМАНа,
# сюда попадает через modules/secrets_bootstrap. Прочие настройки — в
# config/deepseek.py (MODEL / BASE_URL / TIMEOUT / MAX_TOKENS).
# ============================================================================
DEEPSEEK_API_KEY=your_deepseek_key_here

# ============================================================================
# Telegram (уведомления и боты)
# ============================================================================
# Токены ботов (префикс TELEGRAM_TOKEN_ автоматически собирает все токены)
TELEGRAM_TOKEN_VALSTANBOT=your_bot_token_here
TELEGRAM_TOKEN_AFONYA=your_bot_token_here

# Chat ID для алертов (получить через @userinfobot в Telegram)
TELEGRAM_ALERT_CHAT_ID=your_chat_id_here

# Отметка о прогоне классификатора («ПРОГОН») — время разбора уходит владельцу
# в Telegram со строкой «сколько прошло с прошлого». Нужна, пока очередь
# разбирают вручную (DeepSeek 402, P177). Вешается на POST /api/classifier/verdicts
# при recorded > 0. Читается на каждом вызове — переключение без рестарта.
CLASSIFIER_PILOT_NOTIFY=0

# ============================================================================
# Редакционная отсечка «advertisement» (шаг 3 звена 5, P091)
# ============================================================================
# CLASSIFIER_ADVERTISEMENT_FILTER_ENABLED — 1 (дефолт): отсечка «слепого
# второго редактора» режет, как сейчас; 0: снята на всей сети.
# Глобально снимать нельзя: цену шага мерить фактической причиной, поэтому
# сначала — проба на одном районе (P091, рекомендация).
CLASSIFIER_ADVERTISEMENT_FILTER_ENABLED=1
#
# CLASSIFIER_ADVERTISEMENT_FILTER_EXEMPT_REGIONS — коды регионов (CSV), где
# отсечка НЕ применяется: проба на одном районе. Пусто — отсечка работает
# везде, как сейчас. Коды — как в scripts/smoke_test.py --region (mi, ur, klz…).
# Переключение — env + рестарт воркера.
#CLASSIFIER_ADVERTISEMENT_FILTER_EXEMPT_REGIONS=
# ============================================================================
# MAX (мессенджер VK) — канал уведомлений о рекламных заявках
# ============================================================================
# MAX_TOKEN — токен бота «САРАФАН» (платформа MAX для партнёров → Чат-боты).
# Раздаётся владельцем через комнату КАРМАНА; в процесс попадает через
# modules/secrets_bootstrap (имя в ACCEPTED_NAMES).
MAX_TOKEN=your_max_bot_token_here

# MAX_WEBHOOK_SECRET — наш секрет подписки: им MAX подписывает вебхук
# (заголовок X-Max-Bot-Api-Secret). Генерируется на боксе, в чат не пишется.
MAX_WEBHOOK_SECRET=change_me

# MAX_CHAT_ID — чат-получатель. НЕобязательно: бот запоминает его сам из
# события bot_started (владелец нажал «Старт» в диалоге с ботом).
# MAX_CHAT_ID=

# AD_NEURAL_MODE — режим нейросетевого судьи рекламных заявок (MiniMax):
# off (по умолчанию) | assist (судья решает серую зону) | assist_veto
# (судья ещё и снимает алгоритмичные заявки — рискованно).
AD_NEURAL_MODE=off

# ============================================================================
# Нейро-движок: предохранитель и бюджет пути публикации (ADR-0013)
# ============================================================================
# Под лимитом free-тира пересказ/фильтр стоят в единственном слоте воркера и
# ждут ответа, которого не будет (21.10: 371 http_429 за 48 ч, ~40 с на пост).
# ENGINE_BREAKER_ENABLED=1     # 0 — выключить предохранитель (аварийный откат)
# ENGINE_BREAKER_FAILS=3       # сколько отказов подряд открывают предохранитель
# ENGINE_BREAKER_COOLDOWN=300  # на сколько секунд он открывается
# OPENCODE_PUBLISH_TIMEOUT=25  # бюджет всего вызова движка внутри волны, сек
#                              # (ручные прогоны и батчи живут по OPENCODE_TIMEOUT)

# ============================================================================
# MongoDB (опционально, для миграции из old_postopus)
# ============================================================================
# MONGO_CLIENT=mongodb://localhost:27017

# ============================================================================
# Server
# ============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=WARNING
# LOG_LEVEL=DEBUG   # для разработки
# LOG_LEVEL=INFO    # для прода

# ============================================================================
# Production Workflow (JSON)
# ============================================================================
PRODUCTION_WORKFLOW_CONFIG={"max_posts_per_regions":100,"max_digest_posts":5,"work_hours_start":7,"work_hours_end":22,"publish_mode":"test","region_pause_seconds":150}

# ============================================================================
# VK Production Groups (JSON маппинг region_code -> group_id)
# ============================================================================
VK_PRODUCTION_GROUPS={"mi":-123456789,"vp":-987654321}

# ============================================================================
# Test Polygon (опционально)
# ============================================================================
VK_TEST_GROUP_ID=-137760500

# ============================================================================
# КАРМАН vault (bootstrap-конфиг клиента восстановления, сценарий A)
# ============================================================================
# Секреты из комнаты КАРМАНа приезжают в процесс через bootstrap: пара
# «.env.example ↔ allowlist» (modules/secrets_bootstrap.py::ACCEPTED_NAMES)
# меняется ВМЕСТЕ: новый рантайм-секрет → в env-файл приложения, сюда и в
# ACCEPTED_NAMES. Bootstrap-имена ниже — НЕ часть allowlist (свойство 6):
# SECRETS_TOKEN и SECRETS_VAULT_URL никогда не принимаются из ответа vault,
# а читаются только из окружения процесса.
#
# Адрес хранилища — роль, а не значение: технический домен в отслеживаемом
# файле это инфра-деталь, а репозиторий публичный (AGENTS.md, «Что не
# публикуется»). Конкретное значение кладётся владельцем в env-файл
# приложения на проде и в локальное окружение.
# SECRETS_TOKEN=<токен комнаты, выданный при онбординге>
# SECRETS_VAULT_URL=https://<хост-хранилища>/api/secrets
